# Dependencies
node_modules/

# WXT / build output
.output/
.wxt/
dist/
*.zip

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example
!.env.submit.example

# Claude Code local config
# Local agent state stays untracked, but shared agent playbooks (skills) are
# versioned so any machine/agent gets them with the repo.
.claude/*
!.claude/skills/

# Local dev runner config (machine-specific Firefox binary path)
web-ext.config.ts

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Test / coverage
coverage/
.vitest/
test-results/
playwright-report/
# Vitest browser-mode failure screenshots (regenerated on failure, not source)
**/__screenshots__/

# Tooling caches
.playwright-mcp/

# Demo video: vendored HyperFrames agent skills (reinstall: npx skills add heygen-com/hyperframes;
# pinned by skills-lock.json) and regenerable outputs (see promo/demo-video/README.md).
# Screencasts/ stays tracked — it is the only copy of the raw footage.
promo/demo-video/.agents/
promo/demo-video/skeinos-demo.mp4
promo/demo-video/skeinos-demo.gif
website/adapters/
.playwright-screenshots/

# Private planning + launch material (a sparse checkout of the skeinos-private repo).
# Never commit this to the public repo.
notes/
