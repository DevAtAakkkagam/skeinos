{
  "name": "skeinos",
  "description": "A unified workspace layer for your LLM chats.",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check:size": "node scripts/check-bundle-size.mjs",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:all": "vitest run && vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@zag-js/core": "^1.41.1",
    "@zag-js/dialog": "^1.41.1",
    "@zag-js/menu": "^1.41.1",
    "@zag-js/types": "^1.41.1",
    "@zag-js/utils": "^1.41.1",
    "idb": "^8.0.3",
    "preact": "^10.25.4"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/browser": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.0.5",
    "wxt": "^0.20.26"
  }
}
