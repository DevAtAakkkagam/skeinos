# Store-publish credentials for publish-browser-extension / the
# publish-extension GitHub workflow. Copy to .env.submit (gitignored) for
# local use; mirror the same names as GitHub repo secrets for CI.

# --- Chrome Web Store (API v2, service account) -----------------------------
# Setup: enable "Chrome Web Store API" in a Google Cloud project, create a
# service account (no roles) + JSON key, then add the service account email
# under Account in the CWS developer dashboard. Publisher ID is shown under
# Publisher settings in the dashboard.
CHROME_API_VERSION=v2
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
# The full PEM string from the JSON key's private_key field (keep the \n escapes).
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Firefox AMO -------------------------------------------------------------
# Setup: generate API credentials at
# https://addons.mozilla.org/en-US/developers/addon/api/key/
FIREFOX_EXTENSION_ID=skeinos@aakkagam.com
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
