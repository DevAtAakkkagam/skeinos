{
  "platformId": "perplexity",
  "configVersion": "1.3.0",
  "hostMatch": ["*://*.perplexity.ai/*"],
  "selectors": {
    "conversationList": "nav[class*=\"group/sidebar\"]",
    "conversationItem": "a[href^=\"/search/\"]",
    "conversationTitle": "[class*=\"truncate\"]",
    "conversationTitleAttr": "aria-label",
    "conversationIdAttr": "href",
    "conversationUrlPattern": "/search/[^/?#]+",
    "messageUser": "[class*=\"group/query\"]",
    "messageAssistant": "[id^=\"markdown-content\"]",
    "composer": "#ask-input",
    "sendButton": "button[aria-label=\"Submit\"]",
    "sidebarAnchor": "nav[class*=\"group/sidebar\"]",
    "inputBarAnchor": "div:has(> #ask-input)",
    "authedMarker": "[*|href=\"#pplx-icon-user-filled\"]"
  },
  "behaviors": {
    "insertMode": "execCommand",
    "submitMode": "click",
    "supportsSystemPrompt": false,
    "composerStealsFocus": true
  }
}
