{
  "platformId": "claude",
  "configVersion": "2.0.0",
  "hostMatch": ["*://claude.ai/*"],
  "selectors": {
    "conversationList": "aside.dframe-sidebar",
    "conversationItem": "[data-row-key^=\"chat:\"]",
    "conversationTitle": "[data-row-main-button]",
    "conversationIdAttr": "data-row-key",
    "conversationIdPattern": "^chat:(.+)$",
    "conversationUrlPattern": "/chat/([^/?#]+)",
    "messageUser": "[data-testid=\"user-message\"]",
    "messageAssistant": ".font-claude-response",
    "composer": "[data-testid=\"chat-input\"]",
    "sendButton": "button[aria-label=\"Send message\"]",
    "sidebarAnchor": "aside.dframe-sidebar",
    "inputBarAnchor": "fieldset",
    "authedMarker": "[data-testid=\"user-menu-button\"]"
  },
  "behaviors": {
    "insertMode": "react-set",
    "submitMode": "enter",
    "supportsSystemPrompt": true
  }
}
