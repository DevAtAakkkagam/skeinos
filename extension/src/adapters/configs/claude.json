{
  "platformId": "claude",
  "configVersion": "1.0.1",
  "hostMatch": ["*://claude.ai/*"],
  "selectors": {
    "conversationList": "nav[aria-label=\"Sidebar\"]",
    "conversationItem": "a[href^=\"/chat/\"]",
    "conversationTitle": ".sr-only",
    "conversationIdAttr": "href",
    "messageUser": "[data-testid=\"user-message\"]",
    "messageAssistant": ".font-claude-message",
    "composer": "[data-testid=\"chat-input\"]",
    "sendButton": "button[aria-label=\"Send message\"]",
    "sidebarAnchor": "nav[aria-label=\"Sidebar\"]",
    "inputBarAnchor": "fieldset"
  },
  "behaviors": {
    "insertMode": "react-set",
    "submitMode": "click",
    "supportsSystemPrompt": true
  }
}
